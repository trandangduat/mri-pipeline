{
  "name": "neuroflow-tauri-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run backend:cleanup && (cd .. && ./.venv/bin/python -m app_backend.server --host 127.0.0.1 --port 8765 &) && vite --host 127.0.0.1 --port 1420",
    "vite": "vite --host 127.0.0.1 --port 1420",
    "build": "npm run typecheck && vite build",
    "tauri": "tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "cargo:test": "cd src-tauri && cargo test",
    "cargo:clippy": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "check:all": "npm run typecheck && npm run lint && npm run format:check && npm run knip && npm run test && npm run build && npm run cargo:clippy && npm run cargo:test",
    "vite:cleanup": "fuser -k 1420/tcp 2>/dev/null; true",
    "backend": "cd .. && ./.venv/bin/python -m app_backend.server --host 127.0.0.1 --port 8765",
    "backend:cleanup": "cd .. && ./.venv/bin/python -m app_backend.dev_cleanup --host 127.0.0.1 --port 8765 --backend-root .",
    "tauri:dev": "export WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1; npm run vite:cleanup && npm run backend:cleanup && tauri dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "jsdom": "^30.0.1",
    "knip": "^6.32.1",
    "prettier": "^3.9.6",
    "shadcn": "^4.16.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  }
}
