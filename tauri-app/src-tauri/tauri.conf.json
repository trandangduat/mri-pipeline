{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NeuroFlow",
  "version": "0.1.0",
  "identifier": "edu.mri-pipeline.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NeuroFlow",
        "width": 1200,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 700,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "resources": [
      "../../app_backend",
      "../../pipeline",
      "../../remote",
      "../../pipeline_runner.py",
      "../../requirements.txt"
    ]
  }
}
